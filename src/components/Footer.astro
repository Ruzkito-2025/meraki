---
import { whatsapp, whatsappDisplay } from '../data/site';
import Icon from './Icon.astro';
---
<footer class="footer">
  <div class="shell footer-main">
    <div class="footer-brand"><img src="/logo-meraki.png" alt="MERAKI" width="84" height="84"/><p>Arquitectura, construcción e interiorismo.<br/>De la idea a la obra, un solo equipo.</p></div>
    <div class="footer-col"><span>Navegación</span><a href="/">Inicio</a><a href="/estudio">Estudio</a><a href="/servicios">Servicios</a><a href="/proyectos">Proyectos</a><a href="/contacto">Contacto</a></div>
    <div class="footer-col"><span>Servicios</span><a href="/servicios">Diseño arquitectónico</a><a href="/servicios">Construcción</a><a href="/servicios">Interiorismo</a><a href="/servicios">Gestión</a></div>
    <div class="footer-col"><span>Contacto</span><a class="footer-contact-link" href={`https://wa.me/${whatsapp}`} target="_blank" rel="noreferrer"><Icon name="message-circle" size={15}/>{whatsappDisplay}</a><p class="footer-contact-link"><Icon name="map-pin" size={15}/>Lima, Perú</p><a href="/privacidad">Privacidad</a><a href="/terminos">Términos</a></div>
  </div>
  <div class="shell footer-bottom"><span>© 2026 MERAKI Arquitectura & Construcción</span><button type="button" data-back-top>Volver arriba <Icon name="arrow-up" size={15}/></button></div>
</footer>
<a class="whatsapp-fab" href={`https://wa.me/${whatsapp}`} target="_blank" rel="noreferrer" aria-label="Abrir WhatsApp"><Icon name="message-circle" size={27} strokeWidth={1.8}/></a>
