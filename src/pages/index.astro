---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects, services } from '../data/site';
import Icon from '../components/Icon.astro';
const featured = projects.filter(p=>p.featured).slice(0,3);
---
<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-media-wrap"><img class="hero-media" src="/images/image2.jpeg" alt="Proyecto Bayobar de MERAKI" fetchpriority="high" decoding="async" /></div>
    <div class="hero-shade"></div>
    <div class="shell hero-content"><p class="kicker hero-kicker reveal">Arquitectura · Construcción · Interiorismo</p><h1 id="hero-title" class="reveal delay-1">Arquitectura que imagina.<br/><span>Construcción que transforma.</span></h1><div class="hero-bottom reveal delay-2"><p>Diseñamos, desarrollamos y construimos espacios pensados para durar.</p><a class="text-link light" href="/proyectos">Explorar proyectos <Icon name="arrow-down-right" size={17}/></a></div></div>
    <a class="hero-cta reveal delay-3" href="/contacto">Quiero cotizar mi proyecto <Icon name="arrow-right" size={18}/></a>
  </section>

  <section class="studio section">
    <div class="shell studio-grid"><div class="section-label reveal"><span>01</span> Meraki</div><div class="studio-title reveal"><h2>Diseñamos espacios.<br/>Construimos proyectos.<br/><em>Creamos valor.</em></h2></div><div class="studio-copy reveal"><p>Desarrollamos proyectos integrales combinando diseño, ingeniería y construcción para convertir ideas en espacios funcionales, estéticos y bien ejecutados.</p><a class="text-link" href="/estudio">Conoce el estudio <Icon name="arrow-right" size={16}/></a></div></div>
  </section>

  <section class="stats-band">
    <div class="shell stats-grid">
      <div class="stat-item reveal"><strong>1.8M</strong><span>Comunidad educativa</span></div>
      <div class="stat-item reveal delay-1"><strong>+85</strong><span>Proyectos con método</span></div>
      <div class="stat-item reveal delay-2"><strong>+29</strong><span>Ciudades atendidas</span></div>
      <div class="stat-item reveal delay-3"><strong>+6</strong><span>Años online</span></div>
    </div>
  </section>

  <section class="services section section-soft">
    <div class="shell"><div class="section-head reveal"><div class="section-label"><span>02</span> Servicios</div><h2>Un solo equipo.<br/><em>De la idea a la obra.</em></h2><p>Una mirada integral para diseñar, desarrollar y ejecutar cada proyecto.</p></div><div class="service-list">{services.map(service => <article class="service-row reveal"><span class="service-num">{service.num}</span><span class="service-icon" aria-hidden="true"><Icon name={service.icon} size={24}/></span><h3>{service.title}</h3><p>{service.copy}</p></article>)}</div><p class="section-action"><a class="text-link" href="/servicios">Ver todos los servicios <Icon name="arrow-right" size={16}/></a></p></div>
  </section>

  <section class="projects section">
    <div class="shell projects-intro reveal"><div class="section-label"><span>03</span> Proyectos</div><h2>Espacios con identidad.<br/><em>Obras con propósito.</em></h2><p>Una selección de proyectos residenciales y comerciales desarrollados por MERAKI.</p></div>
    <div class="shell project-grid home-project-grid">{featured.map(project => <a class="project-card reveal" href={`/proyectos/${project.slug}`}><figure><img src={project.images[0]} loading="lazy" decoding="async" alt={project.name}/></figure><div class="project-card-copy"><span>{project.category}</span><h3>{project.name}</h3><p>{project.place}</p></div></a>)}</div>
    <div class="shell section-action"><a class="text-link" href="/proyectos">Ver todos los proyectos <Icon name="arrow-right" size={16}/></a></div>
  </section>

  <section class="cta-band section-dark"><div class="shell cta-band-inner"><div><span>¿Tienes un proyecto en mente?</span><h2>Conversemos sobre cómo<br/>podemos hacerlo realidad.</h2></div><a class="nav-cta" href="/contacto"><span>Hablemos</span><Icon name="arrow-up-right" size={17}/></a></div></section>
</BaseLayout>
