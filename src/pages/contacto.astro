---
import BaseLayout from '../layouts/BaseLayout.astro';
import { whatsapp, whatsappDisplay } from '../data/site';
---
<BaseLayout title="Contacto | MERAKI" description="Cuéntanos sobre tu proyecto y conversemos por WhatsApp.">
  <section class="inner-hero"><div class="shell inner-hero-grid"><div><div class="section-label"><span>01</span> Contacto</div><h1>Hablemos de<br/><em>tu proyecto.</em></h1></div><p>Cuéntanos qué tienes en mente. Organizaremos la información y continuaremos la conversación directamente por WhatsApp.</p></div></section>
  <section class="contact section section-soft"><div class="shell contact-grid"><div class="contact-copy reveal"><h2>Cuéntanos sobre<br/><em>tu proyecto.</em></h2><p>Mientras más contexto nos compartas, mejor podremos orientarte en el primer contacto.</p><a class="contact-direct" href={`https://wa.me/${whatsapp}`} target="_blank">WhatsApp <strong>{whatsappDisplay}</strong> <span>↗</span></a><p class="contact-location">Lima, Perú</p></div><form class="contact-form reveal delay-1" data-whatsapp-form><label><span>Nombre</span><input name="nombre" autocomplete="name" required placeholder="Tu nombre completo"/></label><label><span>WhatsApp</span><input name="telefono" autocomplete="tel" inputmode="tel" required placeholder="Número de contacto"/></label><label><span>Tipo de proyecto</span><select name="tipo" required><option value="">Seleccionar</option><option>Diseño arquitectónico</option><option>Construcción</option><option>Interiorismo</option><option>Supervisión / Gestión</option><option>Otro</option></select></label><label><span>Ubicación</span><input name="ubicacion" placeholder="Distrito / ciudad"/></label><label class="full"><span>Cuéntanos brevemente</span><textarea name="mensaje" rows="5" placeholder="Tipo de espacio, área aproximada, etapa actual o cualquier detalle importante"></textarea></label><label class="privacy-check full"><input type="checkbox" required/><span>Acepto que mis datos sean usados para responder esta solicitud según la <a href="/privacidad">Política de Privacidad</a>.</span></label><button class="submit-btn full" type="submit"><span>Enviar por WhatsApp</span><i>↗</i></button></form></div></section>
  <script slot="scripts" is:inline define:vars={{ whatsapp }}>document.querySelector('[data-whatsapp-form]')?.addEventListener('submit',event=>{event.preventDefault();const data=new FormData(event.currentTarget);const message=['Hola MERAKI, quisiera cotizar un proyecto.','',`Nombre: ${data.get('nombre')||''}`,`WhatsApp: ${data.get('telefono')||''}`,`Tipo de proyecto: ${data.get('tipo')||''}`,`Ubicación: ${data.get('ubicacion')||''}`,`Detalle: ${data.get('mensaje')||'Por conversar'}`].join('\n');window.open(`https://wa.me/${whatsapp}?text=${encodeURIComponent(message)}`,'_blank','noopener,noreferrer');});</script>
</BaseLayout>
